# =============================================================================
# POS Backend (Node.js + Express) - Environment Variables Example
# =============================================================================
# Salin file ini ke `.env` dan isi nilai yang sesuai.
# JANGAN PERNAH commit `.env` ke Git (sudah ada di .gitignore).
#
# Untuk deployment (Render/Railway/production), masukkan nilai-nilai ini
# di dashboard platform masing-masing (Environment Variables),
# bukan di `.env` di repo.
# =============================================================================

# ---------------- DATABASE ---------------------------------------------------
# Backend terhubung ke database MySQL/MariaDB produksi.
#
# LOCAL (MariaDB development di mesin ini):
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=              <-- kosong untuk local MariaDB
#   DB_NAME=pos_db
#
# AIVEN (production, WAJIB SSL):
#   DB_HOST=<host>.mysql.aivencloud.com
#   DB_PORT=<port>              <-- port custom Aiven
#   DB_USER=avnadmin
#   DB_PASSWORD=<password-aiven>
#   DB_NAME=pos_db
#   DB_SSL_REJECT_UNAUTHORIZED=true   <-- WAJIB untuk Aiven
#
# Catat: jika backend di-deploy di cloud (Render/Railway),
# DB_HOST TIDAK BOLEH localhost. Gunakan endpoint publik
# database production (Aiven) yang reachable dari internet.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_db
DB_SSL_REJECT_UNAUTHORIZED=false

# ---------------- SERVER -----------------------------------------------------
# Port backend production (platform akan set ini via env, tapi aman punya fallback).
PORT=3000

# ---------------- AUTHENTICATION ---------------------------------------------
# JWT secret untuk menandatangani token (pakai string random panjang & unik).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pos_backend_secret_2026

# ---------------- EMAIL (sendmail OTP reset password) ------------------------
EMAIL_USER=ampremm1602@gmail.com
EMAIL_PASS=<app-password-gmail>

# ---------------- OTP / NOTIFIKASI -------------------------------------------
# WhatsApp via Fonnte:
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=<token-fonnte>
# SMS via SMSApi / OTP.ID:
SMS_API_KEY=<smsapi-key>
OTP_ID_API_KEY=<otp-id-key>
OTP_BRAND=vinPOS

# ---------------- FIREBASE ADMIN (Google login) ------------------------------
# Service account JSON dari Firebase Console.
# Jangan pernah share private key.
FIREBASE_PROJECT_ID=posvin-77e4a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@posvin-77e4a.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<isi-dari-json-service-account>\n-----END PRIVATE KEY-----
